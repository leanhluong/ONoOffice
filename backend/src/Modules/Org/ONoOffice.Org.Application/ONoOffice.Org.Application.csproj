<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <KernelReference Include="Luong.Kernel" />
    <KernelReference Include="Luong.Kernel.Application" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ONoOffice.Org.Domain\ONoOffice.Org.Domain.csproj" />
    <ProjectReference Include="..\ONoOffice.Org.Contracts\ONoOffice.Org.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\ONoOffice.Identity.Contracts\ONoOffice.Identity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Handler để `internal` là cố ý: ngoài MediatR ra thì không ai được gọi thẳng chúng.
      Test thì cần, và mở đúng cho một assembly test rẻ hơn nhiều so với việc nới mọi
      handler thành `public` — nới ra thì tầng Api có thể gọi tắt qua handler và đi vòng
      hết ba pipeline behavior (validation, transaction, logging).
    -->
    <InternalsVisibleTo Include="ONoOffice.Org.UnitTests" />
  </ItemGroup>

</Project>
