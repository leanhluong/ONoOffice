<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      CỐ Ý KHÔNG đặt <NeutralLanguage>vi</NeutralLanguage>.

      Nghe thì hợp lý — tiếng Việt đúng là ngôn ngữ gốc. Nhưng thuộc tính đó nói với
      ResourceManager rằng bản tiếng Việt nằm TRONG assembly chính, nên khi được hỏi
      bằng culture "vi" nó sẽ không thèm mở satellite assembly vi/ nữa. Mà bản dịch
      tiếng Việt của ta lại nằm đúng ở đó (Messages.vi.resx sinh ra vi/...resources.dll,
      không có file Messages.resx trung tính nào cả).

      Hậu quả: MỌI phép tra tiếng Việt trả về null, và toàn hệ thống lặng lẽ rơi về câu
      mặc định viết cứng trong code.
    -->
  </PropertyGroup>

  <ItemGroup>
    <KernelReference Include="Luong.Kernel" />
    <KernelReference Include="Luong.Kernel.AspNetCore" />
    <KernelReference Include="Luong.Kernel.Application" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Bên XÁC MINH token. Bên PHÁT nằm ở Identity.Infrastructure và dùng
      Microsoft.IdentityModel.JsonWebTokens 8.x — hai gói này phải cùng đời, lệch nhau
      thì lỗi hiện ra dưới dạng "token hợp lệ nhưng không xác minh được", rất khó lần.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />

    <!--
      Chỉ phục vụ `dotnet ef` lúc phát triển — nó cần một project khởi động để dựng được
      DbContext thật (đủ chuỗi kết nối, đủ interceptor).

      PrivateAssets="all" nghĩa là gói này KHÔNG theo vào bản publish. Không đặt thì công
      cụ thiết kế đi thẳng lên máy chủ thật: nặng thêm mà chẳng ai dùng, và là bề mặt tấn
      công cho không.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Identity\ONoOffice.Identity.Infrastructure\ONoOffice.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Org\ONoOffice.Org.Infrastructure\ONoOffice.Org.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    KHÔNG khai <EmbeddedResource> cho Resources/Messages.{vi,en}.resx.

    Quy ước mặc định của SDK đã làm đúng thứ ta cần: thấy đuôi ngôn ngữ trong tên file,
    nó biên dịch mỗi file thành một SATELLITE ASSEMBLY riêng — vi/ONoOffice.Api.resources.dll
    và en/... — và đó chính xác là nơi ResourceManager đi tìm khi được hỏi bằng một
    CultureInfo.

    Ép chúng thành tài nguyên nhúng trong assembly chính (bằng LogicalName chẳng hạn)
    sẽ làm mọi phép tra theo culture trả về null, im lặng: hệ thống vẫn chạy, chỉ là
    không bao giờ dịch được câu nào.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="ONoOffice.Api.IntegrationTests" />
  </ItemGroup>

</Project>
