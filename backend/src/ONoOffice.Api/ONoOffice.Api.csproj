<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <KernelReference Include="Luong.Kernel" />
    <KernelReference Include="Luong.Kernel.AspNetCore" />
    <KernelReference Include="Luong.Kernel.Application" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Identity\ONoOffice.Identity.Infrastructure\ONoOffice.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Org\ONoOffice.Org.Infrastructure\ONoOffice.Org.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Nhúng .resx vào assembly. LogicalName đặt tay để tên tài nguyên không phụ thuộc
      cấu trúc thư mục — dời file sang chỗ khác thì ResourceManager vẫn tìm ra.
    -->
    <EmbeddedResource Update="ResourcesMessages.vi.resx" LogicalName="ONoOffice.Api.Resources.Messages.vi.resources" />
    <EmbeddedResource Update="ResourcesMessages.en.resx" LogicalName="ONoOffice.Api.Resources.Messages.en.resources" />
  </ItemGroup>

</Project>
